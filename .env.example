# This file is a template. PaperLeet does not load .env automatically.
# Copy to .env, fill values, then: set -a; source .env; set +a

# Institutional email OTP (server only). Enable email auth, put {{ .Token }}
# in the Supabase Magic Link template, and configure custom SMTP for recipients
# outside your Supabase project team. See docs/community.md.
SUPABASE_URL=''
SUPABASE_PUBLISHABLE_KEY=''
# Legacy anon key is accepted if SUPABASE_PUBLISHABLE_KEY is unset/empty.
SUPABASE_ANON_KEY=''

# Comma-separated, reviewed institutional mailboxes. These users must still
# verify their mailbox and pass institutions.yaml; never use a service-role key.
PAPERLEET_ADMIN_EMAILS=''
# Leave 0 for local HTTP. Use 1 only with an HTTPS deployment.
# This switch does not make the current local judge safe for public hosting.
PAPERLEET_SECURE_COOKIES='0'

# Optional paper generation. Independent of community sign-in.
OPENAI_API_KEY=''
PAPERLEET_MODEL=''
