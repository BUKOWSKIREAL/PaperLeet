# Copy to deploy/.env for the local Docker + Cloudflare Tunnel beta.
# Never commit deploy/.env or share its tokens.
PAPERLEET_DOMAIN=paperleet.com
PAPERLEET_AUTH_MODE=test
# Create a remotely managed Cloudflare Tunnel, then paste only its token here.
TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token
# Generate a different internal token with: openssl rand -hex 32
PAPERLEET_JUDGE_TOKEN=replace-with-a-random-64-character-hex-token
# Test accounts need no Supabase or email provider.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
PAPERLEET_INVITE_EMAILS=
PAPERLEET_ADMIN_EMAILS=
