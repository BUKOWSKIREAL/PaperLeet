# Build from the repository root:
# docker build -f deploy/Dockerfile.judge -t paperleet-worker:local .
FROM python:3.12-slim
WORKDIR /opt/paperleet
RUN pip install --no-cache-dir torch==2.6.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir numpy==2.2.4 pytest==8.3.5 pytest-timeout==2.3.1 PyYAML==6.0.2
ENV PYTHONPATH=/opt/paperleet PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PAPERLEET_ROOT=/opt/paperleet OMP_NUM_THREADS=2 MKL_NUM_THREADS=2
# Explicit allowlist: never COPY the repository, .env, accounts, databases,
# browser files, model credentials, or the Docker socket into this image.
COPY pyproject.toml conftest.py ./
COPY paperleet/__init__.py paperleet/catalog.py ./paperleet/
COPY paperleet/common/*.py ./paperleet/common/
COPY paperleet/judge/*.py ./paperleet/judge/
COPY paperleet/hosting/__init__.py paperleet/hosting/judge_client.py paperleet/hosting/worker.py ./paperleet/hosting/
COPY problems/rl/gae/ ./problems/rl/gae/
COPY problems/rl/ppo_clip/ ./problems/rl/ppo_clip/
COPY problems/rl/dpo/ ./problems/rl/dpo/
COPY problems/rl/grpo/ ./problems/rl/grpo/
COPY problems/rl/dr_grpo/ ./problems/rl/dr_grpo/
COPY problems/diffusion/schedules/ ./problems/diffusion/schedules/
COPY problems/diffusion/param_conversion/ ./problems/diffusion/param_conversion/
COPY problems/diffusion/ddpm_sampling/ ./problems/diffusion/ddpm_sampling/
COPY problems/diffusion/ddim/ ./problems/diffusion/ddim/
COPY problems/diffusion/flow_matching/ ./problems/diffusion/flow_matching/
COPY problems/rl/gspo/ ./problems/rl/gspo/
COPY problems/rl/opd/ ./problems/rl/opd/
COPY problems/rl/dapo/ ./problems/rl/dapo/
COPY problems/finetuning/lora/ ./problems/finetuning/lora/
COPY problems/finetuning/qlora/ ./problems/finetuning/qlora/
COPY problems/diffusion/meanflow/ ./problems/diffusion/meanflow/
COPY problems/diffusion/jit/ ./problems/diffusion/jit/
COPY problems/diffusion/drifting/ ./problems/diffusion/drifting/
COPY problems/diffusion/dmd/ ./problems/diffusion/dmd/
COPY problems/diffusion/dmd2/ ./problems/diffusion/dmd2/
COPY problems/diffusion/consistency/ ./problems/diffusion/consistency/
COPY problems/architecture/attention/ ./problems/architecture/attention/
COPY problems/architecture/multihead_attention/ ./problems/architecture/multihead_attention/
COPY problems/architecture/layer_norm/ ./problems/architecture/layer_norm/
COPY problems/architecture/positional_encoding/ ./problems/architecture/positional_encoding/
COPY problems/architecture/positionwise_ffn/ ./problems/architecture/positionwise_ffn/
COPY problems/optimization/adamw/ ./problems/optimization/adamw/
COPY problems/architecture/flash_attention/ ./problems/architecture/flash_attention/
COPY problems/representation/clip/ ./problems/representation/clip/
COPY problems/optimization/muon_split/ ./problems/optimization/muon_split/
COPY problems/rl/glm5_offpolicy/ ./problems/rl/glm5_offpolicy/
COPY problems/architecture/kimi_kda/ ./problems/architecture/kimi_kda/
COPY problems/architecture/block_attention_residual/ ./problems/architecture/block_attention_residual/
COPY problems/architecture/situ_glu/ ./problems/architecture/situ_glu/
COPY problems/diffusion/progressive_distillation/ ./problems/diffusion/progressive_distillation/
COPY problems/finetuning/opsd_alignment/ ./problems/finetuning/opsd_alignment/
COPY problems/finetuning/opsd_clipping/ ./problems/finetuning/opsd_clipping/
COPY problems/rl/sdpo_feedback/ ./problems/rl/sdpo_feedback/
COPY problems/rl/sdpo_topk/ ./problems/rl/sdpo_topk/
COPY problems/representation/repa/ ./problems/representation/repa/
COPY problems/representation/rotation_trick/ ./problems/representation/rotation_trick/
COPY problems/architecture/differential_attention/ ./problems/architecture/differential_attention/
COPY problems/diffusion/block_diffusion/ ./problems/diffusion/block_diffusion/
COPY problems/finetuning/distillm2/ ./problems/finetuning/distillm2/
COPY problems/rl/pkpo/ ./problems/rl/pkpo/
COPY problems/finetuning/svdquant/ ./problems/finetuning/svdquant/
COPY problems/representation/moge_alignment/ ./problems/representation/moge_alignment/
COPY problems/diffusion/daps/ ./problems/diffusion/daps/
COPY problems/diffusion/diffusion_nft/ ./problems/diffusion/diffusion_nft/
COPY problems/architecture/var_next_scale/ ./problems/architecture/var_next_scale/
COPY problems/representation/var_tokenizer/ ./problems/representation/var_tokenizer/
COPY problems/diffusion/fd_population/ ./problems/diffusion/fd_population/
COPY problems/diffusion/fd_loss/ ./problems/diffusion/fd_loss/
USER 65534:65534
ENTRYPOINT ["python", "-m", "paperleet.hosting.worker"]
