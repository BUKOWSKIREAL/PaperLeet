{$PAPERLEET_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        X-Frame-Options DENY
    }
    request_body {
        max_size 256KB
    }
    handle /api/* {
        reverse_proxy api:8765 {
            header_up X-PaperLeet-Client-IP {remote_host}
            transport http {
                response_header_timeout 180s
            }
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
